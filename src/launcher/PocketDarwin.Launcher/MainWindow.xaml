<Window x:Class="PocketDarwin.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PocketDarwin · iOS Virtual Device" Height="600" Width="850"
        MinHeight="520" MinWidth="720" Background="#0B0F15" Foreground="#EAF0FA"
        FontFamily="Segoe UI Variable Text, Segoe UI" Loaded="Window_Loaded">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="*" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="POCKETDARWIN" Foreground="#86A9FF" FontSize="12" FontWeight="Bold" />
            <TextBlock Text="Реальный iOS-гость в QEMU" FontSize="30" FontWeight="SemiBold" Margin="0,8,0,0" />
            <TextBlock Text="Панель запуска для Windows · без нарисованного интерфейса телефона" Foreground="#AAB5C6" FontSize="14" Margin="0,5,0,0" />
        </StackPanel>
        <Border Grid.Row="2" Background="#151A22" BorderBrush="#263244" BorderThickness="1" CornerRadius="18" Padding="24">
            <StackPanel>
                <TextBlock Text="Состояние компьютера" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,20" />
                <TextBlock Text="Процессор и память" Foreground="#93A0B3" />
                <TextBlock Text="{Binding CpuStatus}" FontSize="16" Margin="0,4,0,18" />
                <TextBlock Text="Ubuntu / WSL" Foreground="#93A0B3" />
                <TextBlock Text="{Binding DistroStatus}" FontSize="16" Margin="0,4,0,18" />
                <TextBlock Text="Графическое окно WSLg" Foreground="#93A0B3" />
                <TextBlock Text="{Binding WslgStatus}" FontSize="16" Margin="0,4,0,18" />
                <TextBlock Text="Диагностика" Foreground="#93A0B3" />
                <TextBlock Text="{Binding Errors}" TextWrapping="Wrap" FontSize="14" Margin="0,4,0,18" />
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="#AFC5FF" FontSize="15" />
            </StackPanel>
        </Border>
        <DockPanel Grid.Row="4">
            <TextBlock Text="iOS 26 / T8030: совместимость ещё проверяется" Foreground="#93A0B3" VerticalAlignment="Center" />
            <Button Content="Проверить компьютер" Click="Refresh_Click"
                    Background="#9BB8FF" Foreground="#101722" BorderThickness="0" Padding="18,11" FontWeight="SemiBold" HorizontalAlignment="Right" />
        </DockPanel>
    </Grid>
</Window>
